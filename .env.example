# Optional. If unset, a key is auto-generated and persisted to /data/.secret_key
SECRET_KEY=

# Optional. If set, the setup wizard requires this token on step 1.
SETUP_TOKEN=
# Public URL used for OAuth redirects (Fyers callback). Empty or localhost => manual paste flow.
PUBLIC_BASE_URL=http://igris.bnfkquodqjp.uk/

# Port the app listens on inside the container (compose maps 4024:4024)
PORT=4024

# Where SQLite + secrets live (mounted as a volume in compose)
DATA_DIR=/data
